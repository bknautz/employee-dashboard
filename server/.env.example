PORT=5000

# The frontend origin allowed to make cross-origin requests (CORS).
# In production this becomes your deployed frontend's real URL.
CLIENT_URL=http://localhost:5173

# Local dev (outside Docker): your MongoDB Atlas connection string.
# Docker Compose overrides this to point at the local `mongo` container instead -
# see docker-compose.yml.
MONGO_URI=your-mongodb-atlas-uri-here

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
