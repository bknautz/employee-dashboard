{
  "info": {
    "_postman_id": "employee-dashboard-auth-collection",
    "name": "Employee Dashboard - Auth",
    "description": "Role x route verification matrix for the auth layer (requireAuth, requireRole, refresh flow).\n\nHow to run:\n1. Start the server (`node server.js` in /server) so it's listening on http://localhost:5000.\n2. Run folder \"1. Register\" first, top to bottom — each request saves its tokens into collection variables that the later folders depend on.\n3. Then run folders 2, 3, and 4 in any order. Each request has a Postman test assertion on the expected status code, visible in the \"Test Results\" tab after clicking Send.\n4. Re-running \"1. Register\" is safe — emails are timestamped so they won't collide with previous runs. The registered users are NOT auto-deleted; clean them out of Atlas afterward if you don't want scratch data sitting there (filter by email containing \"postman-\").\n5. You can also select the whole collection and click \"Run\" (Collection Runner) to fire every request in order in one pass.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "employeeAccessToken", "value": "" },
    { "key": "employeeRefreshToken", "value": "" },
    { "key": "managerAccessToken", "value": "" },
    { "key": "managerRefreshToken", "value": "" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "adminRefreshToken", "value": "" },
    { "key": "refreshedAccessToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Register",
      "item": [
        {
          "name": "Register Employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('employeeAccessToken', data.accessToken);",
                  "pm.collectionVariables.set('employeeRefreshToken', data.refreshToken);",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Role in response is employee', () => pm.expect(data.user.role).to.eql('employee'));",
                  "pm.test('Returned an access token', () => pm.expect(data.accessToken).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Employee\",\n  \"email\": \"postman-employee-{{$timestamp}}@example.com\",\n  \"password\": \"testpass123\",\n  \"role\": \"employee\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Register Manager",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('managerAccessToken', data.accessToken);",
                  "pm.collectionVariables.set('managerRefreshToken', data.refreshToken);",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Role in response is manager', () => pm.expect(data.user.role).to.eql('manager'));",
                  "pm.test('Returned an access token', () => pm.expect(data.accessToken).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Manager\",\n  \"email\": \"postman-manager-{{$timestamp}}@example.com\",\n  \"password\": \"testpass123\",\n  \"role\": \"manager\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Register Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('adminAccessToken', data.accessToken);",
                  "pm.collectionVariables.set('adminRefreshToken', data.refreshToken);",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Role in response is admin', () => pm.expect(data.user.role).to.eql('admin'));",
                  "pm.test('Returned an access token', () => pm.expect(data.accessToken).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Admin\",\n  \"email\": \"postman-admin-{{$timestamp}}@example.com\",\n  \"password\": \"testpass123\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Protected Route - GET /me (any authenticated role)",
      "item": [
        {
          "name": "GET /me as Employee (expect 200)",
          "event": [
