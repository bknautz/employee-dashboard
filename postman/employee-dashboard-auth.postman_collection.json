    {
      "name": "4. Refresh Flow",
      "item": [
        {
          "name": "POST /refresh with valid Employee refresh token (expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('refreshedAccessToken', data.accessToken);",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returned a new access token', () => pm.expect(data.accessToken).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{employeeRefreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            }
          },
          "response": []
        },
